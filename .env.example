# PostgreSQL + PostGIS (incrément 0.2)
DATABASE_URL=

# Auth.js (incrément 0.3)
AUTH_SECRET=
AUTH_URL=

# Google OAuth (optionnel)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Apple Sign In (optionnel)
APPLE_ID=
APPLE_SECRET=

# SMTP Brevo (optionnel) — en dev sans SMTP, le lien magique est loggé en console
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=

# URL publique de l'application
NEXT_PUBLIC_APP_URL=

# Fenêtre de retrait click & collect, en heures (défaut 48).
# Même fenêtre que l’empreinte Stripe (incrément 2.3) — voir docs/reservations.md.
RESERVATION_PICKUP_HOURS=

# Stripe Connect, mode test uniquement dans .env (jamais de clé en dur).
# sk_test_… / pk_test_… / whsec_…
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Commission Achille si Merchant.feeRate est vide (Decimal, ex. 0.08 = 8 %).
STRIPE_DEFAULT_FEE_RATE=0.08
# No-show après la date limite : cancel (défaut, empreinte libérée) ou partial
# (capture d’une pénalité). STRIPE_NOSHOW_PENALTY_RATE est obligatoire si partial
# (Decimal entre 0 et 1, ex. 0.20 = 20 % du total).
STRIPE_NOSHOW_MODE=cancel
STRIPE_NOSHOW_PENALTY_RATE=

# Analytics souveraine (incrément 1.5) — laisser vide = aucune mesure envoyée.
# Plausible (recommandé, UE). Domaine tel qu'enregistré chez Plausible :
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
# Optionnel : script auto-hébergé (sinon https://plausible.io/js/script.js)
NEXT_PUBLIC_PLAUSIBLE_SRC=
# Alternative Matomo UE (ignorée si NEXT_PUBLIC_PLAUSIBLE_DOMAIN est défini) :
NEXT_PUBLIC_MATOMO_URL=
NEXT_PUBLIC_MATOMO_SITE_ID=

# Carte MapLibre + IGN Géoplateforme (incrément 1.2) — au moins l'une des deux.
# Style vectoriel Plan IGN (recommandé) :
# NEXT_PUBLIC_IGN_STYLE_URL=https://data.geopf.fr/annexes/ressources/vectorTiles/styles/PLAN.IGN/standard.json
NEXT_PUBLIC_IGN_STYLE_URL=
# Sinon, gabarit de tuiles raster WMTS (TILEMATRIX={z}&TILEROW={y}&TILECOL={x}) :
NEXT_PUBLIC_IGN_TILES_URL=

# Production Clever Cloud — à renseigner dans la console (pas dans ce fichier) :
# CC_PRE_RUN_HOOK=bash clevercloud/pre-run.sh
# CC_NODE_VERSION=22
# HOSTNAME=0.0.0.0
