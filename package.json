    "maplibre-gl": "^4.7.1",
    "next": "16.3.5",
    "next-auth": "^5.0.0-beta.32",
    "nodemailer": "^8.0.11",
    "prisma": "6.19.3",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
